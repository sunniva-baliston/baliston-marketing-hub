<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Baliston Marketing & Content Hub</title>
  <style>
    :root {
      --bg: #ffffff;
      --sidebar: #f7f7f5;
      --border: #e6e6e3;
      --text: #2f3437;
      --muted: #6b7280;
      --accent: #0969da;
      --card-bg: #fbfbfa;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
      color: var(--text);
      background: var(--bg);
      display: flex;
      min-height: 100vh;
      line-height: 1.6;
    }
    aside {
      width: 260px;
      background: var(--sidebar);
      border-right: 1px solid var(--border);
      padding: 24px 16px;
      position: fixed;
      height: 100vh;
      overflow-y: auto;
    }
    aside h2 { font-size: 14px; font-weight: 700; margin-bottom: 16px; padding-left: 8px; }
    aside nav a {
      display: block;
      padding: 6px 10px;
      color: var(--text);
      text-decoration: none;
      border-radius: 6px;
      font-size: 14px;
      margin-bottom: 2px;
    }
    aside nav a:hover { background: #ebebea; }
    .nav-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--muted);
      margin: 18px 0 6px 10px;
      letter-spacing: 0.04em;
    }
    main {
      margin-left: 260px;
      max-width: 920px;
      padding: 48px 56px;
      width: 100%;
    }
    .icon { font-size: 40px; margin-bottom: 12px; }
    h1 { font-size: 32px; font-weight: 700; margin-bottom: 8px; }
    .subtitle { color: var(--muted); font-size: 15px; margin-bottom: 28px; }
    .callout {
      background: #f1f5f9;
      border-left: 4px solid var(--accent);
      padding: 14px 18px;
      border-radius: 6px;
      font-size: 14px;
      margin-bottom: 32px;
    }
    h2.section { font-size: 20px; margin: 32px 0 14px; border-bottom: 1px solid var(--border); padding-bottom: 6px; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 14px;
      margin-bottom: 24px;
    }
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 16px;
    }
    .card h3 { font-size: 15px; margin-bottom: 6px; }
    .card p { font-size: 13px; color: var(--muted); }
    .tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 12px;
      margin-bottom: 8px;
    }
    .tofu { background: #ffedd5; color: #c2410c; }
    .mofu { background: #dbeafe; color: #1d4ed8; }
    .bofu { background: #dcfce7; color: #15803d; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; margin-top: 12px; }
    th, td { border: 1px solid var(--border); padding: 10px 12px; text-align: left; }
    th { background: var(--sidebar); font-weight: 600; }
    @media (max-width: 768px) {
      aside { display: none; }
      main { margin-left: 0; padding: 28px 20px; }
    }
  </style>
</head>
